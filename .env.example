# Environment configuration template for Aerial Crowd Intelligence
PROJECT_NAME="Aerial Crowd Intelligence"
ENVIRONMENT="development"
DEBUG="false"

# Security (Replace with strong random secrets in production)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
ALGORITHM="HS256"

# Database (PostgreSQL for production, SQLite for local dev)
# Local SQLite default:
DATABASE_URL="sqlite:///./crowdlytics.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg2://crowd_user:crowd_pass@localhost:5432/crowdlytics_db"

# Storage
STORAGE_TYPE="local"
MEDIA_ROOT="./storage"

# Limits
MAX_IMAGE_SIZE_MB="50"
MAX_VIDEO_SIZE_MB="500"
MAX_VIDEO_DURATION_SECONDS="300"
