# Environment configuration template for Aerial Crowd Intelligence
PROJECT_NAME="Aerial Crowd Intelligence"
ENVIRONMENT="development"
DEBUG="false"
DEFAULT_DETECTOR="person"
# PERSON_MODEL_PATH may override backend/models/overhead_person.onnx

# Database
# Local development default (zero-dependency SQLite):
DATABASE_URL="sqlite:///./crowdlytics.db"
# Local Docker PostgreSQL alternative:
# DATABASE_URL="postgresql+psycopg2://crowdlytics:crowdlytics_secret@127.0.0.1:5432/crowdlytics"

# Redis & Celery (Local Docker or host queue)
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"

# Storage Layout (Private Local Storage)
STORAGE_TYPE="local"
DATA_ROOT="./data"
MEDIA_ROOT="./data/uploads"
PROCESSED_ROOT="./data/processed"
RESULTS_ROOT="./data/results"
TEMPORARY_ROOT="./data/temporary"

# Network & Host Binding
HOST="127.0.0.1"
PORT="8000"
FRONTEND_URL="http://localhost:5173"

# Media Processing Limits
MAX_IMAGE_SIZE_MB="50"
MAX_VIDEO_SIZE_MB="500"
MAX_VIDEO_DURATION_SECONDS="300"

