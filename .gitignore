# ==========================================
# Local Media Storage (Private by Design)
# ==========================================

# Ignore generated media at the repository root
/storage/

# Ignore uploaded/generated media under backend
/backend/storage/

# Ignore generated media and processing outputs
media_uploads/
data/uploads/*
data/processed/*
data/results/*
data/temporary/*

# Preserve placeholder files for required directories
!data/**/.gitkeep

# ==========================================
# Python Storage Service
# ==========================================

# Allow the storage implementation to be committed
!backend/app/storage/
!backend/app/storage/service.py

# ==========================================
# Databases, Logs & Runtime Files
# ==========================================
*.db
*.sqlite
*.sqlite3
*.log
*.pid
/backend/models/*.onnx

# ==========================================
# IDE & OS
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
